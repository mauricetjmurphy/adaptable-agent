# LLM Provider API Keys
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# GitHub
# Personal Access Token — needs repo:read scope; add repo:write if CreatePullRequestTool is enabled
GITHUB_TOKEN=your_github_token_here

# Jira
# API token from https://id.atlassian.com/manage-account/security/api-token
JIRA_API_URL=https://your-company.atlassian.net
JIRA_USERNAME=your_atlassian_email_here
JIRA_API_TOKEN=your_jira_api_token_here

# Email
# Set EMAIL_PROVIDER to one of: gmail, outlook, smtp
EMAIL_PROVIDER=gmail

# Gmail — OAuth 2.0 credentials from https://console.cloud.google.com (Gmail API scope)
GMAIL_CLIENT_ID=your_gmail_client_id_here
GMAIL_CLIENT_SECRET=your_gmail_client_secret_here

# Outlook — OAuth 2.0 credentials from https://portal.azure.com (Mail.Read + Mail.Send scopes)
OUTLOOK_CLIENT_ID=your_outlook_client_id_here
OUTLOOK_CLIENT_SECRET=your_outlook_client_secret_here
OUTLOOK_TENANT_ID=your_outlook_tenant_id_here

# SMTP — fallback for any provider that supports IMAP/SMTP
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your_email_here
SMTP_PASSWORD=your_smtp_password_here

# Agent Configuration
DEFAULT_MODEL=gpt-4
DEFAULT_TEMPERATURE=0.7
MAX_ITERATIONS=10

# Rate Limiting
RATE_LIMIT_REQUESTS_PER_MINUTE=60

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/agent.log

# Memory Configuration
VECTOR_STORE_PATH=data/vector_store
MEMORY_MAX_TOKENS=2000

# Safety
REQUIRE_APPROVAL_FOR_SENSITIVE_TOOLS=true
ENABLE_AUDIT_LOGGING=true
